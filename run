#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$project_dir"
if command -v cargo >/dev/null 2>&1; then
    cargo_bin=cargo
elif [ -x "$HOME/.cargo/bin/cargo" ]; then
    cargo_bin="$HOME/.cargo/bin/cargo"
else
    echo "Rust is required to build. Install it from https://rustup.rs" >&2
    exit 1
fi
exec "$cargo_bin" run --quiet --release --locked -- "$@"
